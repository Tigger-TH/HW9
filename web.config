<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <!--
      แก้ปัญหาตัวอักษรไทยเพี้ยน (mojibake) ในหน้า .aspx
      fileEncoding   = บอก ASP.NET ให้ "อ่าน" ไฟล์ .aspx/.ascx เป็น UTF-8 เสมอ
      requestEncoding = encoding ที่ใช้อ่านข้อมูลที่ผู้ใช้ POST เข้ามา (เช่น ฟอร์ม guestbook/contact)
      responseEncoding = encoding ที่ใช้ "เขียน" HTML กลับไปให้เบราว์เซอร์
    -->
    <globalization
      fileEncoding="utf-8"
      requestEncoding="utf-8"
      responseEncoding="utf-8"
      culture="th-TH"
      uiCulture="th-TH" />
  </system.web>
</configuration>
